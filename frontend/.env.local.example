# Backend URL (server-side only — Next.js rewrites forward /api/* here)
TURING_API_URL=http://localhost:8005

# Admin key — server-only, NEVER prefix with NEXT_PUBLIC_
# Injected by the /proxy/admin/[...path] Route Handler.
# Leave empty to disable the operator console in a public deploy (returns 404).
TURING_ADMIN_KEY=

# Optional: pre-seed a tenant API key for local dev (avoids the portal sign-in)
# NEXT_PUBLIC_TURING_API_KEY=tk_...

# Optional: public URL of this console (used in claim link emails)
# NEXT_PUBLIC_CONSOLE_URL=http://localhost:3001
