# ── Service ──────────────────────────────────────────────────────────────
APP_NAME=turing_service
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8005

# ── Voice engine (currently Bolna) ────────────────────────────────────────
# Get your API key from the Bolna dashboard. Sub-account keys are prefixed "sa-".
VOICE_ENGINE_API_KEY=your_bolna_api_key_here
VOICE_ENGINE_BASE_URL=https://api.bolna.ai
VOICE_ENGINE_TIMEOUT_SECONDS=30
# Default caller-ID (E.164) used when a call/batch request omits one and the
# client has no configured default_from_number. Must be one of the account's
# owned numbers (see GET /v1/phone-numbers).
VOICE_DEFAULT_FROM_NUMBER=

# ── Datastore (turing's own Postgres — docker compose up -d postgres) ────
DATABASE_URL=postgresql+asyncpg://turing:turing@localhost:5433/turing_db

# ── Admin surface: operator credential for /v1/admin/* (X-Admin-Key) ─────
ADMIN_API_KEY=change-me-admin-key

# ── Webhooks / callbacks ─────────────────────────────────────────────────
# Public base URL of this service; handed to the voice engine as webhook_url.
# Leave empty in local dev (the engine can't reach localhost; use reconcile poll).
TURING_PUBLIC_URL=
# Source IPs allowed on /webhooks/voice (Bolna: 13.203.39.153). Empty = allow all (dev).
VOICE_WEBHOOK_ALLOWED_IPS=

# ── Redis (docker compose up -d redis) ────────────────────────────────────
# Used for one-time claim links and durable rate limiting.
# Set to empty to disable claim links (approve still works, key shown copy-paste only).
REDIS_URL=redis://:turing@localhost:6380/0
TURING_REDIS_PASSWORD=turing
TURING_REDIS_PORT=6380

# ── Client onboarding ─────────────────────────────────────────────────────
# Public base URL of the Next.js console; used to build one-time claim links.
# Must be reachable by the client receiving the link.
CONSOLE_PUBLIC_URL=http://localhost:3001
CLAIM_LINK_TTL_HOURS=24

# ── Proxy headers (behind nginx / ALB / Docker bridge) ────────────────────
# Comma-separated IPs (or CIDRs) that are trusted to set X-Forwarded-For.
# uvicorn reads this to resolve the real client IP for rate limiting.
# Example: FORWARDED_ALLOW_IPS=172.17.0.1
# Leave empty for local dev (uvicorn defaults to trusting 127.0.0.1 only).
# FORWARDED_ALLOW_IPS=

# ── Tuning (optional — defaults shown) ────────────────────────────────────
AGENT_SYNC_INTERVAL_MINUTES=15
API_KEY_CACHE_TTL_SECONDS=60
REGISTER_RATE_LIMIT_PER_HOUR=10

# ── SQL Builder Agent (app/sql_agent/) ────────────────────────────────────
# Control-plane DB: the agent's OWN dedicated database (sql_agent_db) — a new
# database on the same server as turing_db is fine, but NEVER turing_db itself.
# Bootstrap it with: python -m app.sql_agent.control_db.bootstrap
SQL_AGENT_CONTROL_DB_URL=postgresql+asyncpg://turing:turing@localhost:5433/sql_agent_db
# Target (Kalaam) DB via the SELECT-only sql_agent_readonly role. Read-only is
# enforced server-side on the role AND per-connection by the app.
KALAAM_READONLY_DATABASE_URL=postgresql+asyncpg://sql_agent_readonly:change-me@localhost:5435/continental-pilot-local
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Call analysis (LLM classification layer) ──────────────────────────────────
# System-level defaults. Each client can override provider + model via their
# ClientConfig (admin PUT /v1/admin/clients/{id}/config). The API key is always
# the system key; per-client keys are stored encrypted in client_config.
LLM_PROVIDER=openai                    # anthropic | openai
LLM_MODEL=                             # leave blank to use provider default
# ENCRYPTION_KEY=                         # Fernet key for per-client API key encryption
#   Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SQL_AGENT_EXPLAIN_VALIDATION=true
# SQL_AGENT_MAX_REPAIR_ATTEMPTS=3
# SQL_AGENT_MODEL_GENERATE=google_genai:gemini-2.5-flash
# SQL_AGENT_MODEL_SELECT=google_genai:gemini-2.5-flash
# SQL_AGENT_MODEL_PRUNE=google_genai:gemini-2.5-flash
# SQL_AGENT_MODEL_CRITIC=google_genai:gemini-2.5-flash
# SQL_AGENT_MODEL_REPAIR=google_genai:gemini-2.5-flash

# password=local-dev-operator