# ── Service ──────────────────────────────────────────────────────────────
APP_NAME=turing_service
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ── Bolna ────────────────────────────────────────────────────────────────
# Get your API key from the Bolna dashboard. Sub-account keys are prefixed "sa-".
BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_BASE_URL=https://api.bolna.ai
BOLNA_TIMEOUT_SECONDS=30
# Default caller-ID (E.164) used when a call/batch request omits one.
# Must be one of your Bolna-owned numbers (see GET /v1/phone-numbers).
BOLNA_DEFAULT_FROM_NUMBER=

# ── Datastore (turing's own Postgres — docker compose up -d postgres) ────
DATABASE_URL=postgresql+asyncpg://turing:turing@localhost:5433/turing_db

# ── Service auth: keys consumers present in X-API-Key (comma-separated) ──
TURING_API_KEYS=dev-turing-key

# ── Webhooks / callbacks ─────────────────────────────────────────────────
# Public base URL of this service; handed to Bolna as webhook_url.
# Leave empty in local dev (Bolna can't reach localhost; use reconcile poll).
TURING_PUBLIC_URL=
# Kalaam callback endpoint for lean outcomes + its HMAC secret.
KALAAM_WEBHOOK_URL=http://localhost:8000/internal/turing/call-completed
KALAAM_WEBHOOK_SECRET=change-me-shared-secret
# Source IPs allowed on /webhooks/bolna (Bolna: 13.203.39.153). Empty = allow all (dev).
BOLNA_WEBHOOK_ALLOWED_IPS=
